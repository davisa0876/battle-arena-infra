POSTGRES_DB=battle_arena
POSTGRES_USER=battle_arena
POSTGRES_PASSWORD=battle_arena_secret
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# Host bind addresses for published ports (each service is independent).
# Everything defaults to 127.0.0.1 (not reachable from the LAN).
#
# Physical mobile device testing on the local network:
#   set API_BIND_ADDRESS=0.0.0.0 and REALTIME_BIND_ADDRESS=0.0.0.0
#   (optionally WEB_BIND_ADDRESS=0.0.0.0), set PUBLIC_WS_URL=ws://<LAN-IP>:3001/ws,
#   then point the mobile app at http://<your-LAN-IP>:8000
#
# NEVER set POSTGRES_BIND_ADDRESS / REDIS_BIND_ADDRESS / MINIO_BIND_ADDRESS to 0.0.0.0
# for normal development: databases, cache and object storage must stay off the LAN.
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
REALTIME_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
MINIO_BIND_ADDRESS=127.0.0.1

# WebSocket API (gateway, stage /ws) — default local-only
REALTIME_PORT=3001
PUBLIC_WS_URL=ws://localhost:3001/ws
WS_TICKET_TTL_SECONDS=30
WS_TICKET_REDIS_PREFIX=battle-arena:ws-ticket:
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# S3 stand-in (RustFS). Always running: Lambda has no persistent disk, so avatars live here.
MINIO_ROOT_USER=battlearena
MINIO_ROOT_PASSWORD=battlearena_minio
MINIO_BUCKET=battle-arena-profiles
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# EventBridge-style rule run by the gateway (function|rate-seconds|JSON payload).
# Leave unset for the default `schedule:run` every minute; set to empty to disable.
# SCHEDULES=

# Mailpit (email verification / password reset). UI: http://localhost:8025
MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
