POSTGRES_DB=battle_arena
POSTGRES_USER=battle_arena
POSTGRES_PASSWORD=battle_arena_secret
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# Host bind address for published ports.
# Default 127.0.0.1 keeps Postgres/Redis/API/Web off the LAN.
# For physical mobile device testing on the local network, set:
#   BIND_ADDRESS=0.0.0.0
# Then point the mobile app at http://<your-LAN-IP>:8000
BIND_ADDRESS=127.0.0.1

# Optional local S3 (RustFS). Start with: docker compose --profile storage up -d
FILESYSTEM_DISK=local
MINIO_ROOT_USER=battlearena
MINIO_ROOT_PASSWORD=battlearena_minio
MINIO_BUCKET=battle-arena-profiles
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
